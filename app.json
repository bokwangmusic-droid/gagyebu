    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1ccc4e2c-2375-4c68-91b8-2434105ad349"
      }
    },
    "owner": "ijcompany",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/1ccc4e2c-2375-4c68-91b8-2434105ad349"
    }
  }
}
