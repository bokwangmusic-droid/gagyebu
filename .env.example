# Supabase project connection — mobile-safe values only.
#
# EXPO_PUBLIC_* vars are inlined into the JS bundle at build time (Expo's
# built-in .env support, no extra config needed). Never put a service_role /
# secret key here or anywhere else the app can reach — only the anon /
# publishable key belongs on the client; RLS is what actually protects data.
#
# Copy this file to `.env` (untracked, see .gitignore) and fill in the real
# values from the Supabase dashboard (Project Settings → API).

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
